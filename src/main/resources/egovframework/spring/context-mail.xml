<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
            http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="javaMailSender" class="org.springframework.mail.javamail.JavaMailSenderImpl">
        <property name="host" value="${mail.host:localhost}"/>
        <property name="port" value="${mail.port:25}"/>
        <property name="username" value="${mail.username:}"/>
        <property name="password" value="${mail.password:}"/>
        <property name="defaultEncoding" value="UTF-8"/>
        <property name="javaMailProperties">
            <props>
                <prop key="mail.transport.protocol">${mail.protocol:smtp}</prop>
                <prop key="mail.smtp.auth">${mail.auth:false}</prop>
                <prop key="mail.smtp.starttls.enable">${mail.tls:false}</prop>
                <prop key="mail.smtp.timeout">15000</prop>
                <prop key="mail.smtp.connectiontimeout">15000</prop>
                <prop key="mail.debug">${mail.debug:false}</prop>
            </props>
        </property>
    </bean>
</beans>
